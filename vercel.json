{
  "framework": "vite",
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "installCommand": "npm install",
  "headers": [
    {
      "source": "/share/(.*)",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=86400" },
        { "key": "Vary", "value": "User-Agent" }
      ]
    },
    {
      "source": "/assets/(.*)",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }
      ]
    },
    {
      "source": "/(.*)\\.(webp|avif|png|jpg|jpeg|svg|ico|woff2|woff|mp4|webm)",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }
      ]
    },
    {
      "source": "/(.*)",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=0, must-revalidate" }
      ]
    }
  ],
  "redirects": [
    {
      "source": "/:path*",
      "has": [{ "type": "host", "value": "nearbystudio.in" }],
      "destination": "https://www.nearbystudio.in/:path*",
      "permanent": true
    }
  ],
  "rewrites": [
    {
      "source": "/share/og-logo.jpg",
      "has": [{ "type": "header", "key": "user-agent", "value": ".*WhatsApp.*" }],
      "destination": "/og-image-square.jpg"
    },
    { "source": "/share/og-logo.jpg", "destination": "/og-image.jpg" },
    {
      "source": "/((?!api/|_vercel/).*)",
      "destination": "/spa.html"
    }
  ]
}
